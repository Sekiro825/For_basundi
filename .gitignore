# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Couple photos and generated prints
/collage photos/*.jpg
/collage photos/*.png
/collage photos/*.mp4
/collage photos/final_instax_prints/
/collage photos/processed_instax/


# Private birthday photos/videos — never commit (repo is public).
# Originals live in assets/Photosssss; web copies in private/, served only
# to logged-in visitors by app/birthday/media/[...file]/route.js.
/assets/Photosssss/
/private/
/public/birthday/
*.mp4
